#: data/interfaces/bookstrap/config.html:2918
#: data/interfaces/bookstrap/config.html:2923
#: data/interfaces/bookstrap/config.html:2928
msgid "0 for no limit"
msgstr "0 – bez limitu"

#: data/interfaces/bookstrap/config.html:2919
msgid ""
"How many pages of results are read from a provider in one search, 0 for all "
"of them."
msgstr ""
"Ile stron wyników jest odczytywanych od dostawcy podczas jednego "
"wyszukiwania; 0 oznacza wszystkie."

