#: data/interfaces/bookstrap/config.html:2936
msgid "Cover creation program:"
msgstr "Program na tvorbu obálok:"

#: data/interfaces/bookstrap/config.html:2937
msgid "Cover creation program"
msgstr "Program na tvorbu obálok"

#: data/interfaces/bookstrap/config.html:2938
msgid ""
"Program for creating magazine covers (see wiki for details) Leave blank to "
"use a local copy of ghostscript, or PythonMagick or Wand interfaces to "
"ImageMagick"
msgstr ""
"Program na vytváranie obálok časopisov (podrobnosti nájdete na wiki). Ak "
"chcete použiť lokálnu kópiu ghostscript alebo rozhrania PythonMagick či Wand "
"k ImageMagick, nechajte prázdne"

#: data/interfaces/bookstrap/config.html:2944
