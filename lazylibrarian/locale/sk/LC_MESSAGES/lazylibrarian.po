msgid "Provider Priority Weighting:"
msgstr "Váha priority poskytovateľa:"

#: data/interfaces/bookstrap/config.html:2911
msgid "Priority weight"
msgstr "Váha priority"

#: data/interfaces/bookstrap/config.html:2912
msgid "Multiplier"
msgstr "Násobiteľ"

#: data/interfaces/bookstrap/config.html:2914
msgid ""
"0 = prefer match percentage. Higher values make downloader priority more "
"important when selecting \"best\" match"
msgstr ""
"0 = uprednostniť percento zhody. Vyššie hodnoty dávajú pri výbere "
"„najlepšej“ zhody väčší význam priorite sťahovača"

#: data/interfaces/bookstrap/config.html:2917
